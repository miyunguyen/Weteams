#!/bin/sh
# App 2
REG_TOKEN=
DOMAIN=thpt-daphuc.duckdns.org
ROOT_URL=http://thpt-daphuc.duckdns.org
RELEASE=8.2.1

# SSL/TLS (set https + letsencrypt when ready)
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=demo@email.com
TRAEFIK_PROTOCOL=http

# Project identity (must be unique per app)
COMPOSE_PROJECT_NAME=daphuc

# Rocket.Chat ports
HOST_PORT=3002
PORT=3000
METRICS_PORT=9459
BIND_IP=0.0.0.0

# Rocket.Chat initial admin
ADMIN_USERNAME=
ADMIN_PASS=

# Prometheus
PROMETHEUS_RETENTION_SIZE=15GB
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_PORT=9001

# Grafana
GRAFANA_DOMAIN=
GRAFANA_PATH=/grafana
GRAFANA_ADMIN_PASSWORD=rc-admin-2
GRAFANA_HOST_PORT=5051
GRAFANA_BIND_IP=127.0.0.1

# Traefik ports (must differ if each app runs its own Traefik)
TRAEFIK_HTTP_PORT=8082
TRAEFIK_DASHBOARD_PORT=8081
TRAEFIK_HTTPS_PORT=8443

# MongoDB
MONGODB_BIND_IP=127.0.0.1
MONGODB_PORT_NUMBER=27017
MONGODB_HOST_PORT_NUMBER=27018
MONGODB_HOST_PATH=./.data/mongodb-app2

# NATS
NATS_PORT_NUMBER=4223
NATS_BIND_IP=127.0.0.1
