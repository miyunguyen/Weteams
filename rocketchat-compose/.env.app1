#!/bin/sh
# App 1
REG_TOKEN=
DOMAIN=thpt-trunggia.duckdns.org
ROOT_URL=http://thpt-trunggia.duckdns.org
RELEASE=8.2.1

# SSL/TLS (set https + letsencrypt when ready)
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=demo@email.com
TRAEFIK_PROTOCOL=http

# Project identity (must be unique per app)
COMPOSE_PROJECT_NAME=trunggia

# Rocket.Chat ports
HOST_PORT=3000
PORT=3000
METRICS_PORT=9458
BIND_IP=0.0.0.0

# Rocket.Chat initial admin
ADMIN_USERNAME=
ADMIN_PASS=

# Prometheus
PROMETHEUS_RETENTION_SIZE=15GB
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_PORT=9000

# Grafana
GRAFANA_DOMAIN=
GRAFANA_PATH=/grafana
GRAFANA_ADMIN_PASSWORD=rc-admin
GRAFANA_HOST_PORT=5050
GRAFANA_BIND_IP=127.0.0.1

# Traefik ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTPS_PORT=443

# MongoDB
MONGODB_BIND_IP=127.0.0.1
MONGODB_PORT_NUMBER=27017
MONGODB_HOST_PORT_NUMBER=27017
MONGODB_HOST_PATH=./.data/mongodb-app1

# NATS
NATS_PORT_NUMBER=4222
NATS_BIND_IP=127.0.0.1
