// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String  @id @default(uuid())
  name               String
  composeProjectName String  @unique
  domain             String  @unique
  rootUrl            String  @unique
  rocketUrl          String
  release            String  @default("8.0.1")
  regToken           String?

  hostPort    Int    @default(3000)
  port        Int    @default(3000)
  metricsPort Int    @default(9458)
  bindIp      String @default("0.0.0.0")

  adminUsername      String    @default("admin")
  adminPass          String    @default("admin123")
  adminUserId        String?
  adminAuthToken     String?
  adminTokenExpireAt DateTime?

  mongodbBindIp         String  @default("127.0.0.1")
  mongodbPortNumber     Int     @default(27017)
  mongodbHostPortNumber Int?    @default(27017)
  mongodbHostPath       String?

  natsPortNumber Int    @default(4222)
  natsBindIp     String @default("127.0.0.1")

  envRaw            Json?
  isDeleted         Boolean      @default(false)
  deletedAt         DateTime?
  deployStatus      DeployStatus @default(PENDING)
  deployError       String?
  lastProvisionedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users User[]
  teams Team[]
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  rocketUserId String
  username     String
  name         String?
  email        String?
  role         UserRole?
  dateOfBirth  DateTime?
  address      String?
  citizenId    String?
  phoneNumber  String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  teamMembers TeamMember[]

  @@unique([tenantId, rocketUserId])
  @@unique([tenantId, username])
  @@index([tenantId, name])
  @@index([tenantId, email])
}

model Team {
  id        String   @id @default(uuid())
  tenantId  String
  roomId    String // Rocket roomId
  name      String?
  joinCode  String
  teamId    String // Rocket teamId
  createdAt DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  members TeamMember[]

  @@unique([tenantId, roomId])
  @@unique([tenantId, joinCode])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

enum UserRole {
  TEACHER
  STUDENT
  PARENT
}

enum DeployStatus {
  PENDING
  DEPLOYING
  RUNNING
  FAILED
}
